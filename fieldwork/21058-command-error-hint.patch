+#[derive(Debug, thiserror::Error)]
+#[error("Failed to enumerate installed tools")]
+pub(crate) struct ToolEnumerationError {
+    #[source]
+    source: uv_tool::Error,
+}
+
+impl uv_errors::Hint for ToolEnumerationError {
+    fn hints(&self) -> uv_errors::Hints<'_> {
+        if matches!(&self.source, uv_tool::Error::ToolName(_)) {
+            uv_errors::Hints::from(
+                "Move or remove the invalid directory from the uv tool directory; run `uv tool dir` to locate it",
+            )
+        } else {
+            uv_errors::Hints::none()
+        }
+    }
+}
