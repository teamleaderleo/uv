+#[cfg(test)]
+mod tests {
+    use super::SeenPaths;
+    use std::path::Path;
+
+    #[test]
+    fn exact_duplicate_path_is_rejected() {
+        let mut seen = SeenPaths::default();
+        assert!(seen.insert(Path::new("/python/bin/python")));
+        assert!(!seen.insert(Path::new("/python/bin/python")));
+    }
+
+    #[cfg(windows)]
+    #[test]
+    fn windows_ascii_case_variant_is_rejected() {
+        let mut seen = SeenPaths::default();
+        assert!(seen.insert(Path::new(r"C:\Python312\python.exe")));
+        assert!(!seen.insert(Path::new(r"c:\python312\PYTHON.EXE")));
+    }
+
+    #[cfg(not(windows))]
+    #[test]
+    fn non_windows_case_variant_is_preserved() {
+        let mut seen = SeenPaths::default();
+        assert!(seen.insert(Path::new("/Python/bin/python")));
+        assert!(seen.insert(Path::new("/python/bin/python")));
+    }
+}
