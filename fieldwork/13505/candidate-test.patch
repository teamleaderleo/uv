+
+#[derive(Default)]
+struct SeenPaths(FxHashSet<PathBuf>);
+
+impl SeenPaths {
+    fn insert(&mut self, path: &Path) -> bool {
+        self.0.insert(path_dedup_key(path))
+    }
+}
+
+#[cfg(windows)]
+fn path_dedup_key(path: &Path) -> PathBuf {
+    // Candidate only: covers the reported ASCII drive/component casing without
+    // lossy UTF-8 conversion. A final patch should confirm whether the repository
+    // already has a helper matching Windows ordinal case-insensitive semantics.
+    let mut key: OsString = path.as_os_str().to_os_string();
+    key.make_ascii_lowercase();
+    PathBuf::from(key)
+}
+
+#[cfg(not(windows))]
+fn path_dedup_key(path: &Path) -> PathBuf {
+    path.to_path_buf()
+}
